# Copy this file to .env and fill it in from Supabase: Project Settings > API.
# Use your STAGING project here, so local testing never touches real players' data.
# Both values are public. NEVER put the sb_secret_... key in this file.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
